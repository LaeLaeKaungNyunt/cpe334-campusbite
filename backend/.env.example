# CampusBite Backend Environment Variables (Local Development Example)
# Copy this file to backend/.env for local development:
#   cp backend/.env.example backend/.env
# DO NOT commit real .env files to version control.

# Local PostgreSQL 16 connection URLs (host ports match compose.yaml)
DATABASE_URL="postgresql://campusbite:campusbite_dev_pw@localhost:5433/campusbite_dev?schema=public"
TEST_DATABASE_URL="postgresql://campusbite:campusbite_test_pw@localhost:5434/campusbite_test?schema=public"

# Express server port
PORT=4000

# Runtime environment
NODE_ENV=development

# Allowed frontend origin for CORS and session cookies
FRONTEND_ORIGIN=http://localhost:5173

# Cookie secure flag (false for local HTTP, true in production HTTPS)
COOKIE_SECURE=false

# Synthetic demo password used by prisma/seed.ts (hashed before storing)
SEED_DEMO_PASSWORD=DemoPassword123!
